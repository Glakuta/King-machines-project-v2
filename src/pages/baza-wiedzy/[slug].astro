---
import Layout from '../../layouts/Layout.astro';
import { mockArticles } from '../../lib/mockData.ts';
import type { Article } from '../../types/wp';

export function getStaticPaths() {
  return mockArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const others = mockArticles.filter((a) => a.id !== article.id).slice(0, 3);
---

<Layout title={`${article.title} | King Machines`} description={article.excerpt} type="article">
  <article class="bg-white pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-6">
      <nav class="mb-8 text-sm text-gray-500" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-blue-600">Strona Główna</a></li>
          <li class="mx-2">/</li>
          <li><a href="/baza-wiedzy" class="hover:text-blue-600">Baza Wiedzy</a></li>
          <li class="mx-2">/</li>
          <li class="text-gray-900 font-medium" aria-current="page">{article.title}</li>
        </ol>
      </nav>

      <header class="mb-10">
        <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">{article.category}</span>
        <h1 class="mt-4 text-3xl md:text-4xl font-bold text-gray-900 mb-4">{article.title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
          {article.author && <span>{article.author}</span>}
          <span>{article.date}</span>
          {article.readTime && <span>Czas czytania: {article.readTime}</span>}
        </div>
      </header>

      <img
        src={article.image || 'https://placehold.co/1200x630?text=King+Machines'}
        alt={article.title}
        class="w-full h-auto aspect-[16/9] object-cover rounded-xl mb-10"
      />

      <div class="prose prose-lg max-w-none text-gray-700" set:html={article.content} />
    </div>
  </article>

  {others.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Inne artykuły</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {others.map((a) => (
            <a href={`/baza-wiedzy/${a.slug}`} class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <img
                src={a.image || 'https://placehold.co/400x260?text=King+Machines'}
                alt={a.title}
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-5">
                <span class="text-xs font-medium text-blue-600">{a.category}</span>
                <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">{a.title}</h3>
                <p class="mt-2 text-sm text-gray-600">{a.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
